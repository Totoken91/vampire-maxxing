# Vampire Maxxing — environment variables.
#
# Copy to `.env` (which is gitignored) and fill in the values from your
# Supabase project + Google Cloud Console. Vite injects these into the
# client bundle at build time as `import.meta.env.VITE_*`.
#
# All three vars are required for cloud sync. Without them, the Account
# section in Settings is hidden and the game runs in offline-only mode.

# Supabase project URL — looks like https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (publishable) key — safe to ship in client builds.
# DO NOT use the service_role key here; that's server-only.
VITE_SUPABASE_ANON_KEY=

# Google OAuth 2.0 Web Client ID — looks like:
#   123456789012-abcdef...apps.googleusercontent.com
# Must match the audience configured in Supabase Auth → Providers → Google.
# See docs/SETUP-AUTH.md for the Cloud Console setup steps.
VITE_GOOGLE_WEB_CLIENT_ID=
